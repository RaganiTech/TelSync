<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic for local development (localhost, 10.0.2.2) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>

    <!-- Production config: Strictly enforce TLS/HTTPS for all external communication -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow Tapsell API domains (HTTPS only) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">tapsell.ir</domain>
        <domain includeSubdomains="true">api.tapsell.ir</domain>
        <domain includeSubdomains="true">mediation.tapsell.ir</domain>
        <domain includeSubdomains="true">cdn.tapsell.ir</domain>
        <domain includeSubdomains="true">ad.tapsell.ir</domain>
    </domain-config>
</network-security-config>